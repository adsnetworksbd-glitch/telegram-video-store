# ─── Required ────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me            # plain text is fine; hash not needed

# Firebase: upload firebase-service-account.json (Render "Secret Files") — project id is read from it
# Telegram bot (login + bot): get from BotFather
TELEGRAM_BOT_TOKEN=

