# ──────────────────────────────────────────────
# Video Store Frontend — Environment Variables
# Copy this file to .env.local for development
# ──────────────────────────────────────────────

# Backend API base URL (REQUIRED for production builds — no built-in fallback).
# Must end with /api/v1. Local dev default when unset: http://localhost:8000/api/v1
VITE_API_URL=https://your-backend.onrender.com/api/v1

# Dev mode: set to true to skip Telegram auth gate
# Never set to true in production
VITE_DEV_MODE=false

# Optional: URL of the rewarded-ad network SDK script (e.g. the Monetag Mini App SDK).
# Leave empty to skip loading it. Without an SDK the Watch Ads page shows
# "ad unavailable" and NEVER fakes an ad or an unlock. See src/utils/rewardedAd.ts.
VITE_AD_SDK_URL=
